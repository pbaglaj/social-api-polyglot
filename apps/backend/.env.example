# --- PostgreSQL ---
# Hasło jest podawane przez Docker secret w pliku secrets/postgres_password.txt
POSTGRES_USER=postgres
POSTGRES_DB=social_db
DATABASE_URL=postgresql://postgres:secret@postgres:5432/social_db?schema=public

# --- MongoDB ---
# Hasło jest podawane przez Docker secret w pliku secrets/mongo_password.txt
MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_URI=mongodb://mongo:secret@mongodb:27017/feed_db?authSource=admin

# --- Redis ---
REDIS_URL=redis://redis:6379
CACHE_TTL_SECONDS=30

# --- Services ---
PG_SERVICE_PORT=3001
MONGO_SERVICE_PORT=3002
API_GATEWAY_PORT=8080

# --- Image tagging ---
APP_VERSION=0.1.0

# --- Keycloak (Authorization Server) ---
# Port wystawiony na hosta. Przegladarka i klienci uzywaja http://localhost:8090.
KEYCLOAK_PORT=8090
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
# Dedykowana baza Postgres dla Keycloaka (oddzielona od bazy aplikacji)
KC_DB_USER=keycloak
KC_DB_PASSWORD=keycloak
KC_DB_NAME=keycloak
KEYCLOAK_REALM=SocialPolyglot
# Adres Keycloaka wewnatrz sieci docker (uzywany przez backend do JWKS i Admin REST API)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# --- OAuth2 / walidacja JWT w Resource Server ---
# Klucze publiczne pobierane wewnatrz sieci docker (szybko, bez wystawiania portu).
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/SocialPolyglot/protocol/openid-connect/certs
# Tokeny moga miec issuer z hosta (SPA przez localhost) albo z sieci wewnetrznej (M2M/SSR).
# Akceptujemy oba - to ten sam realm i te same klucze podpisujace.
KEYCLOAK_ALLOWED_ISSUERS=http://localhost:8090/realms/SocialPolyglot,http://keycloak:8080/realms/SocialPolyglot
# Opcjonalna walidacja audience (puste = pomijamy strict aud, sprawdzamy role realm).
KEYCLOAK_AUDIENCE=

# --- Backend -> Keycloak Admin REST API (zarzadzanie userami) ---
KC_ADMIN_CLIENT_ID=backend-admin
KC_ADMIN_CLIENT_SECRET=backend-admin-secret