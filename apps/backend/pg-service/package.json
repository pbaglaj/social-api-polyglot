{
  "name": "pg-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node app.js",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "seed": "prisma db seed",
    "seed:test": "cross-env NODE_ENV=test node prisma/seed.test.js",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run seed",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--no-warnings node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:integration": "cross-env NODE_ENV=test RUN_INTEGRATION=true NODE_OPTIONS=--no-warnings node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration",
    "build": "tsc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@prisma/client": "^6.6.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "prisma": "^6.6.0",
    "prom-client": "^15.1.3",
    "redis": "^4.7.0",
    "sequelize": "^6.37.5",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.0",
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "include": [
    "prisma/**/*",
    "src/**/*"
  ]
}
